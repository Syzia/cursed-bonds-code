# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
# iCloud's duplicate copies of the above ("log 2.txt")
/log *.txt
/errors *.txt
/traceback *.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# macOS
.DS_Store

# Python bytecode from the tools
__pycache__/
*.pyc

# Session scratch: smoke harnesses, screenshot dumps
/game/zz_*.rpy
/shots
/game/shots
